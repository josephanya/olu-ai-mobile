# Copy this file to .env for local development. Do not commit real secrets.

# Flutter code currently reads this via --dart-define=SAHARA_API_KEY=...
# The benchmark runner also reads SAHARA_API_KEY from the process environment.
SAHARA_API_KEY=

# Lowercase alias named in the Sahara integration spec for dotenv-based setups.
sahara_api_key=

# Optional Phase 5 third-model benchmark baseline.
OPENAI_API_KEY=